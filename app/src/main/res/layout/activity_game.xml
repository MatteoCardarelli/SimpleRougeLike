<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.game.GameActivity">

    <!-- La mappa, anche sotto le barre di sistema -->
    <io.github.matteocardarelli.simpleroguelike.ui.render.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Testo e comandi, lontani dalle barre di sistema e dal ritaglio dello schermo -->
    <FrameLayout
        android:id="@+id/hud"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/bars"
            layout="@layout/view_player_bars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp" />

        <!-- Le impostazioni: la partita, il registro dei messaggi e, nelle build di debug, le note -->
        <ImageButton
            android:id="@+id/settings_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shape_status"
            android:contentDescription="@string/settings_button"
            android:src="@drawable/ic_settings" />

        <!-- La salute del boss, quando si vede -->
        <TextView
            android:id="@+id/boss_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="16dp"
            android:background="@drawable/shape_status"
            android:padding="8dp"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Mentre si mira con un oggetto da lanciare: come scegliere la direzione -->
        <TextView
            android:id="@+id/aim_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="96dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/shape_status"
            android:padding="12dp"
            android:text="@string/aim_hint"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:visibility="gone" />

        <!-- Il registro dei messaggi e, nelle build di debug, il turno -->
        <LinearLayout
            android:id="@+id/bottom_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@color/overlay"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:lineSpacingExtra="2dp"
                android:maxLines="4"
                android:minLines="4"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                tools:text="Colpisci per 10 danni.\nSubisci 5 danni." />

            <TextView
                android:id="@+id/debug_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textColor="@android:color/darker_gray"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="turno 7"
                tools:visibility="visible" />

        </LinearLayout>

        <!-- La schermata di fine partita, sopra a tutto il resto -->
        <LinearLayout
            android:id="@+id/end_panel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/overlay"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/end_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:textColor="@android:color/white"
                android:textSize="28sp"
                tools:text="@string/end_game_over" />

            <TextView
                android:id="@+id/end_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                tools:text="Turno 34 · livello 2" />

            <Button
                android:id="@+id/new_game_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/new_game" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
