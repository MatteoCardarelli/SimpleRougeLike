<?xml version="1.0" encoding="utf-8"?>
<!--
    Le impostazioni a tutto schermo: la barra con la X per chiudere e le voci divise in sezioni.
    La partita (seed e nuova partita), la schermata (registro dei messaggi) e, nelle build di
    debug, il collaudo (nota). Gli insets delle barre di sistema diventano il margine interno.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/settings_close"
        app:navigationIcon="@drawable/ic_close"
        app:title="@string/settings_title"
        app:titleTextColor="@color/settings_text" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_game" />

            <LinearLayout style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_seed"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/settings_seed" />

                    <TextView
                        android:id="@+id/seed_value"
                        style="@style/SettingsSummary"
                        android:fontFamily="monospace"
                        android:textIsSelectable="true"
                        tools:text="7709744644529346026" />

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/copy_seed"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/settings_seed_copy_description"
                    android:minHeight="48dp"
                    android:text="@string/settings_seed_copy"
                    app:icon="@drawable/ic_copy" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/new_game"
                style="@style/SettingsRow.Clickable">

                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_new_game"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/new_game" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/settings_new_game_summary" />

                </LinearLayout>

            </LinearLayout>

            <View style="@style/SettingsDivider" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_screen" />

            <LinearLayout style="@style/SettingsRow">

                <ImageView
                    style="@style/SettingsIcon"
                    android:src="@drawable/ic_log"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/log_switch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/settings_show_log"
                        android:textColor="@color/settings_text"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SettingsSummary"
                        android:text="@string/settings_show_log_summary" />

                </LinearLayout>

            </LinearLayout>

            <!-- Solo nelle build di debug -->
            <LinearLayout
                android:id="@+id/testing_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsSection"
                    android:text="@string/settings_section_testing" />

                <LinearLayout
                    android:id="@+id/write_note"
                    style="@style/SettingsRow.Clickable">

                    <ImageView
                        style="@style/SettingsIcon"
                        android:src="@drawable/ic_note"
                        tools:ignore="ContentDescription" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsTitle"
                            android:text="@string/settings_write_note" />

                        <TextView
                            style="@style/SettingsSummary"
                            android:text="@string/settings_write_note_summary" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
