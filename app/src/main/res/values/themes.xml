<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.SimpleRogueLike" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <!--
        Le impostazioni: una finestra a tutto schermo, scura come il gioco anche quando il
        telefono usa il tema chiaro. Il genitore non è DayNight di proposito.
    -->
    <style name="Theme.SimpleRogueLike.Settings" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/settings_section</item>
        <item name="colorPrimaryVariant">@color/teal_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/settings_section</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <!-- Il contenuto passa sotto le barre di sistema e si sposta con gli insets -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- La conferma della nuova partita, scura come le impostazioni da cui si apre -->
    <style name="Theme.SimpleRogueLike.ConfirmDialog" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/settings_section</item>
        <item name="colorSecondary">@color/settings_section</item>
    </style>
</resources>